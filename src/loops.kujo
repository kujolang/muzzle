# Muzzle loop state management.
# Manages stateful multi-step agent loops with JSON persistence.

from src.common import is_trueish, is_falseish, dict_has_key, str_ends_with, ensure_dir, timestamp_iso

LOOPS_DIR := ".muzzle/state/loops"

# Find the active loop file, or return "" if none.
export func find_active_loop() {
	if is_falseish(file_exists(LOOPS_DIR)) {
		return ""
	}
	entries := list_dir(LOOPS_DIR)
	mut idx := 0
	while idx < len(entries) {
		entry_name := to_string(entries[idx])
		# Only process .json loop files
		if is_falseish(str_ends_with(entry_name, ".json")) {
			idx = idx + 1
			continue
		}
		loop_file := LOOPS_DIR + "/" + entry_name
		raw := read_file(loop_file)
		parsed := parse_json(raw)
		if type(parsed) != "Error" {
			if dict_has_key(parsed, "status") {
				if to_string(parsed["status"]) == "active" {
					return loop_file
				}
			}
		}
		idx = idx + 1
	}
	return ""
}

# Load loop state from file.
# Returns a dict or null.
export func load_loop(loop_file) {
	if loop_file == "" || is_falseish(file_exists(loop_file)) {
		return null
	}
	raw := read_file(loop_file)
	parsed := parse_json(raw)
	if type(parsed) == "Error" {
		return null
	}
	return parsed
}

# Save loop state to file.
export func save_loop(loop_file, loop_data) {
	json_str := to_json(loop_data)
	write_file(loop_file, json_str, true)
}

# Create a new loop state.
export func create_loop(workflow_name, limit, ts_start) {
	ensure_dir(LOOPS_DIR)
	loop_file := LOOPS_DIR + "/" + workflow_name + ".json"

	mut data := dict()
	data["workflow"] = workflow_name
	data["limit"] = limit
	data["current"] = 0
	data["status"] = "active"
	data["started_at"] = ts_start
	data["entries"] = array()

	save_loop(loop_file, data)
	return loop_file
}

# Advance the loop to the next iteration.
# Returns updated loop data or null if complete.
export func advance_loop(loop_file) {
	loop_data := load_loop(loop_file)
	if loop_data == null {
		return null
	}

	current := to_int(loop_data["current"])
	limit := to_int(loop_data["limit"])
	next := current + 1

	if next > limit {
		loop_data["status"] = "completed"
		save_loop(loop_file, loop_data)
		return null
	}

	loop_data["current"] = next
	save_loop(loop_file, loop_data)
	return loop_data
}

# Record a completed loop iteration.
export func record_loop_done(loop_file, note, ts) {
	loop_data := load_loop(loop_file)
	if loop_data == null {
		return false
	}

	mut entry := dict()
	entry["loop"] = loop_data["current"]
	entry["status"] = "done"
	entry["note"] = note
	entry["timestamp"] = ts

	entries := loop_data["entries"]
	entries = push(entries, entry)
	loop_data["entries"] = entries

	save_loop(loop_file, loop_data)
	return true
}

# Get all loops, active or completed.
export func list_all_loops() {
	mut result := array()
	if is_falseish(file_exists(LOOPS_DIR)) {
		return result
	}
	entries := list_dir(LOOPS_DIR)
	mut idx := 0
	while idx < len(entries) {
		entry_name := to_string(entries[idx])
		# Only process .json loop files
		if is_falseish(str_ends_with(entry_name, ".json")) {
			idx = idx + 1
			continue
		}
		loop_file := LOOPS_DIR + "/" + entry_name
		loop_data := load_loop(loop_file)
		if loop_data != null {
			result = push(result, loop_data)
		}
		idx = idx + 1
	}
	return result
}
