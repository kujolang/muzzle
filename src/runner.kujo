# Muzzle runner dispatch.
# Supports multiple workflow runners: kujo (default), bash, python, node.
# Runner is determined by:
#   1. Manifest `runner` field (if manifest exists)
#   2. File extension (.kujo -> kujo, .sh -> bash, .py -> python, .js -> node)
#   3. --runner flag override

from src.common import str_ends_with, is_trueish, is_falseish, dict_has_key

# Default runner when nothing else is specified.
DEFAULT_RUNNER := "kujo"

export func runner_catalog() {
	return {
		"kujo": {"extension": ".kujo", "executable": env_or("KUJO_BIN", "kujo"), "label": "kujo"},
		"bash": {"extension": ".sh", "executable": "bash", "label": "bash"},
		"python": {"extension": ".py", "executable": "python3", "label": "python"},
		"node": {"extension": ".js", "executable": "node", "label": "node"}
	}
}

# Return true when the runner is supported.
export func valid_runner(runner) {
	lower := to_lower(to_string(runner))
	return dict_has_key(runner_catalog(), lower)
}

# Resolve the runner for a workflow.
# manifest: parsed manifest dict (or null)
# script_path: path to the workflow script
# flag_override: --runner flag value (or "")
export func resolve_runner(manifest, script_path, flag_override) {
	# 1. CLI flag override takes highest priority
	if flag_override != "" {
		lower := to_lower(flag_override)
		if valid_runner(lower) {
			return lower
		}
	}

	# 2. Manifest runner field
	if manifest != null && dict_has_key(manifest, "runner") {
		runner := to_string(manifest["runner"])
		lower := to_lower(runner)
		if valid_runner(lower) {
			return lower
		}
	}

	# 3. File extension detection
	if is_trueish(str_ends_with(script_path, ".kujo")) {
		return "kujo"
	}
	if is_trueish(str_ends_with(script_path, ".sh")) {
		return "bash"
	}
	if is_trueish(str_ends_with(script_path, ".py")) {
		return "python"
	}
	if is_trueish(str_ends_with(script_path, ".js")) {
		return "node"
	}

	# 4. Default
	return DEFAULT_RUNNER
}

# Execute through the repository helper so workflow output is spooled directly
# to the full log instead of accumulating in the Kujo process. The runtime's
# structured process API supplies timeout/cancellation and Unix process-group
# termination for the helper and all of its descendants.
export func run_workflow(runner, script_path, args_arr, log_path, verbose, timeout_ms, cancel_file) {
	muzzle_root := env_or("MUZZLE_ROOT", path_absolute("."))
	helper_path := to_string(muzzle_root) + "/src/muzzle_exec.sh"
	kujo_bin := env_or("KUJO_BIN", "kujo")
	mut argv := array("bash", helper_path, runner, script_path, log_path, to_string(verbose), kujo_bin, "--")
	mut idx := 0
	while idx < len(args_arr) {
		argv = push(argv, to_string(args_arr[idx]))
		idx = idx + 1
	}
	max_capture := 65536
	if verbose {
		max_capture = 16777216
	}
	mut options := {"timeout_ms": timeout_ms, "max_output_bytes": max_capture}
	if cancel_file != "" {
		options["cancel_file"] = cancel_file
	}
	return spawn_process(argv, options)
}

# Read only a bounded log tail for failure summaries. `tail` is part of the
# documented Unix runtime requirement and avoids reading an arbitrarily large
# workflow log back into agent memory.
export func read_log_tail(log_path, max_lines) {
	if is_falseish(file_exists(log_path)) {
		return ""
	}
	result := spawn_process(array("tail", "-n", to_string(max_lines), log_path), {"timeout_ms": 5000, "max_output_bytes": 65536})
	if result.exitcode != 0 {
		return ""
	}
	return trim_end(result.stdout)
}

# Get the file extension for a runner (for script discovery).
export func runner_extension(runner) {
	catalog := runner_catalog()
	if dict_has_key(catalog, runner) {
		return to_string(catalog[runner]["extension"])
	}
	return ""
}

# Get a human-readable label for a runner.
export func runner_label(runner) {
	catalog := runner_catalog()
	if dict_has_key(catalog, runner) {
		return to_string(catalog[runner]["label"])
	}
	return runner
}
