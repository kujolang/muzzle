{
  "name": "Muzzle hardening before-after outcome evaluation",
  "description": "Deterministic checks over capability evidence generated by the same external workloads for baseline and current.",
  "tests": [
    {"name":"workflow completed and emitted JSON","check":"file_contains","params":{"path":"evidence/run.json","expected":"\"status\":\"success\""}},
    {"name":"raw workflow evidence was retained","check":"file_size_greater_than","params":{"path":"evidence/run.json","bytes":100}},
    {"name":"Muzzle artifacts are owner-only","check":"file_contains","params":{"path":"evidence/artifact-modes.txt","expected":"log=600\nmarkdown=600\njson=600"}},
    {"name":"run result has stable schema discriminator","check":"file_contains","params":{"path":"evidence/run.json","expected":"\"schema_version\":\"muzzle.run/v1\""}},
    {"name":"run result has command discriminator","check":"file_contains","params":{"path":"evidence/run.json","expected":"\"command\":\"run\""}},
    {"name":"forced installer rejects symlinked managed root","check":"file_contains","params":{"path":"evidence/install.exit","expected":"3"}},
    {"name":"forced installer does not write through managed symlink","check":"file_size_less_than","params":{"path":"evidence/install-external-files.txt","bytes":1}},
    {"name":"post-validation workflow mutation is denied","check":"file_contains","params":{"path":"evidence/race.exit","expected":"3"}},
    {"name":"mutated workflow bytes never execute","check":"file_does_not_contain","params":{"path":"evidence/race.log","expected":"mutated-bytes"}},
    {"name":"signed policy parsing remains bound to verified bytes","check":"file_contains","params":{"path":"evidence/policy.exit","expected":"3"}},
    {"name":"policy swap cannot authorize denied workflow","check":"file_does_not_contain","params":{"path":"evidence/policy.json","expected":"\"status\":\"success\""}}
  ]
}
