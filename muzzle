#!/usr/bin/env bash
# =============================================================================
# Muzzle — Quiet Workflow Runner for AI-Assisted Development
# =============================================================================
# Version: 1.0.0
# This is a thin Bash wrapper that delegates to the Kujo-native muzzle.kujo.
# =============================================================================
set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE_PATH" ]]; do
	SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
	SOURCE_PATH="$(readlink "$SOURCE_PATH")"
	case "$SOURCE_PATH" in
		/*) ;;
		*) SOURCE_PATH="${SOURCE_DIR}/${SOURCE_PATH}" ;;
	esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
MUZZLE_KUJO="${SCRIPT_DIR}/muzzle.kujo"
export MUZZLE_ROOT="${SCRIPT_DIR}"

# Resolve Kujo runtime binary
KUJO_BIN="${KUJO_BIN:-}"
if [[ -z "$KUJO_BIN" ]]; then
	# Try common paths for the Kujo language runtime
	if [[ -x "${SCRIPT_DIR}/../kujo/target/debug/kujo" ]]; then
		KUJO_BIN="${SCRIPT_DIR}/../kujo/target/debug/kujo"
	elif [[ -x "${SCRIPT_DIR}/../kujo/target/release/kujo" ]]; then
		KUJO_BIN="${SCRIPT_DIR}/../kujo/target/release/kujo"
	elif command -v kujo &>/dev/null; then
		# Warn: 'kujo' on PATH may be the Python linter, not the Kujo language runtime.
		# If muzzle fails with parse errors, set KUJO_BIN explicitly.
		KUJO_BIN="$(command -v kujo)"
	else
		echo "Error: Kujo language runtime not found." >&2
		echo "" >&2
		echo "The Kujo LANGUAGE runtime is required — this is NOT the Python linter 'kujo'." >&2
		echo "Build it from source:  cd /path/to/kujo && cargo build" >&2
		echo "Or set KUJO_BIN to the binary path:" >&2
		echo "  export KUJO_BIN=/path/to/kujo/target/debug/kujo" >&2
		exit 1
	fi
fi

export KUJO_BIN

# The first-party CLI compatibility package is shipped with the sibling Kujo
# checkout. Keep it configurable for installed runtimes while making the
# workspace wrapper self-contained.
if [[ -z "${KUJO_MODULE_PATH:-}" && -d "${SCRIPT_DIR}/../kujo/modules" ]]; then
	export KUJO_MODULE_PATH="${SCRIPT_DIR}/../kujo/modules"
fi

if [[ ! -f "$MUZZLE_KUJO" ]]; then
	echo "Error: muzzle.kujo not found at ${MUZZLE_KUJO}" >&2
	exit 1
fi

# Run muzzle.kujo via Kujo runtime. Some debug Kujo builds emit optimizer stats
# on stderr; keep Muzzle's CLI contract quiet while preserving real diagnostics.
set +e
"$KUJO_BIN" run "$MUZZLE_KUJO" -- "$@" 2> >(grep -v '^Compiler optimization:' >&2) &
kujo_pid=$!
trap 'kill -INT "$kujo_pid" 2>/dev/null || true; wait "$kujo_pid" 2>/dev/null || true; exit 130' INT
trap 'kill -TERM "$kujo_pid" 2>/dev/null || true; wait "$kujo_pid" 2>/dev/null || true; exit 130' TERM
wait "$kujo_pid"
status=$?
trap - INT TERM
exit "$status"
