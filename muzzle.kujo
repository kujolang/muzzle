# Muzzle — Quiet Workflow Runner for AI-Assisted Development
#
# A Kujo-native CLI that runs known local workflows quietly.
# Captures noisy logs to files, prints compact agent-friendly summaries.
#
# Usage:
#   kujo run muzzle.kujo -- <command> [options]
#   muzzle <command> [options]           (via Bash wrapper)

from src.common import parse_subcommand, flag_value, positional_args
from src.common import is_trueish, is_falseish, str_starts_with, str_ends_with
from src.common import dict_has_key, has_muzzle_dir, format_duration_ms, path_is_within_muzzle
from src.common import timestamp_compact, timestamp_iso, ensure_dir
from src.runner import resolve_runner, valid_runner, build_command, parse_captured_output, runner_label
from src.workflow import load_manifest, resolve_workflow_script, validate_script_path, validate_workflow_name, discover_workflows, get_workflow_info
from src.report import write_markdown_report, write_json_report, make_paths
from src.redact import error_excerpt
from src.loops import find_active_loop, find_invalid_loop_state, load_loop, create_loop, advance_loop, record_loop_done, current_iteration_recorded, list_all_loops

MUZZLE_VERSION := "1.0.0"

WORKFLOWS_DIR := ".muzzle/workflows"
MANIFESTS_DIR := ".muzzle/manifests"
SESSION_FILE := ".muzzle/state/session.json"
SESSION_LOCK_FILE := ".muzzle/state/session.lock"

# =============================================================================
# HELP
# =============================================================================
func print_lines(output_lines) {
	mut idx := 0
	while idx < len(output_lines) {
		print(output_lines[idx])
		idx = idx + 1
	}
}

func print_kv(prefix, value) {
	print(prefix + to_string(value))
}

func print_help() {
	print_lines(array(
		"Muzzle v" + MUZZLE_VERSION + " — Quiet Workflow Runner for AI-Assisted Development",
		"",
		"Usage:",
		"  kujo run muzzle.kujo -- <command> [options]",
		"  muzzle <command> [options]",
		"",
		"Commands:",
		"  init                          Initialize .muzzle/ in current directory",
		"  list                          List available workflows",
		"  info <workflow>               Show workflow details",
		"  run <workflow> [args...]      Run a workflow quietly",
		"  logs [workflow]               Show log file paths",
		"  report [workflow]             Show report file paths",
		"  loop start <wf> --limit <n>   Start a stateful agent loop",
		"  loop next                     Advance to next loop iteration",
		"  loop done --note \"...\"        Record completed iteration",
		"  loop status                   Show loop progress",
		"  loop summary                  Show all loop entries",
		"  clean                         Remove all logs and reports",
		"  help                          Show this help",
		"  version                       Print version",
		"",
		"Run options:",
		"  --verbose, -v    Stream full output to terminal",
		"  --dry-run, -n    Print what would happen without executing",
		"  --json           Output machine-readable JSON summary",
		"  --runner <name>  Force runner: kujo (default), bash, python, node",
		"  --timeout <ms>   Max execution time in ms (default: 300000, min: 1000, max: 3600000)",
		"",
		"Runners:",
		"  kujo             Execute .kujo scripts via KUJO_BIN (default)",
		"  bash             Execute .sh scripts via bash",
		"  python           Execute .py scripts via python3",
		"  node             Execute .js scripts via node",
		"",
		"Examples:",
		"  muzzle init",
		"  muzzle run hello",
		"  muzzle run deploy production --verbose",
		"  muzzle run build --json",
		"  muzzle run analyze --runner python",
		"  muzzle loop start release-pass --limit 10",
		"",
		"Muzzle keeps noisy workflow output out of AI agent context.",
		"Full logs: .muzzle/logs/   Reports: .muzzle/reports/",
		"Docs: https://github.com/kujolang/muzzle"
	))
}

func print_version() {
	print_lines(array(
		"Muzzle v" + MUZZLE_VERSION,
		"Quiet workflow runner for AI-assisted development.",
		"Part of the Kujo ecosystem."
	))
}

func is_run_value_flag(flag_name) {
	if flag_name == "--runner" {
		return true
	}
	if flag_name == "--timeout" {
		return true
	}
	return false
}

func is_run_bool_flag(flag_name) {
	if flag_name == "--verbose" {
		return true
	}
	if flag_name == "-v" {
		return true
	}
	if flag_name == "--dry-run" {
		return true
	}
	if flag_name == "-n" {
		return true
	}
	if flag_name == "--json" {
		return true
	}
	return false
}

func has_run_option(argv, flag_name) {
	mut idx := 1
	while idx < len(argv) {
		arg := to_string(argv[idx])
		if arg == "--" {
			return false
		}
		if arg == flag_name {
			return true
		}
		idx = idx + 1
	}
	return false
}

func run_option_value(argv, flag_name, default_value) {
	mut idx := 1
	while idx < len(argv) {
		arg := to_string(argv[idx])
		if arg == "--" {
			return default_value
		}
		if arg == flag_name {
			if idx + 1 < len(argv) {
				next := to_string(argv[idx + 1])
				if next != "--" {
					return next
				}
			}
			return default_value
		}
		idx = idx + 1
	}
	return default_value
}

func option_missing_value(argv, flag_name) {
	mut idx := 1
	while idx < len(argv) {
		arg := to_string(argv[idx])
		if arg == "--" {
			return false
		}
		if arg == flag_name {
			return idx + 1 >= len(argv) || to_string(argv[idx + 1]) == "--"
		}
		idx = idx + 1
	}
	return false
}

func existing_muzzle_path_is_safe(path) {
	return is_falseish(file_exists(path)) || (is_trueish(path_is_dir(path)) && is_trueish(path_is_within_muzzle(path)))
}

func update_session_state(workflow_name, finished_at) {
	if is_falseish(file_exists(SESSION_FILE)) || is_falseish(path_is_within_muzzle(SESSION_FILE)) {
		return
	}

	mut lock_acquired := false
	mut lock_attempt := 0
	while lock_attempt < 200 && is_falseish(lock_acquired) {
		try {
			write_file_atomic(SESSION_LOCK_FILE, uuid_v4(), false)
			lock_acquired = true
		} except _err {
			sleep(5)
		}
		lock_attempt = lock_attempt + 1
	}
	if is_falseish(lock_acquired) {
		return
	}

	# Session bookkeeping is best-effort and must never replace the workflow's
	# real result when local state is malformed or unwritable.
	try {
		session_raw := read_file(SESSION_FILE)
		session := parse_json(session_raw)
		if type(session) == "dict" {
			total_runs := 0
			if dict_has_key(session, "total_runs") {
				total_runs = to_int(session["total_runs"]) + 1
			} else {
				total_runs = 1
			}
			session["last_workflow"] = workflow_name
			session["last_run_at"] = finished_at
			session["total_runs"] = total_runs
			write_file_atomic(SESSION_FILE, to_json(session), true)
		}
	} except _err {}

	try {
		delete_file(SESSION_LOCK_FILE)
	} except _err {}
}

func parse_run_invocation(argv) {
	mut workflow_name := ""
	mut workflow_args := array()
	mut idx := 1
	mut found_workflow := false
	mut literal_args := false

	while idx < len(argv) {
		arg := to_string(argv[idx])
		mut step := 1

		if literal_args {
			if is_falseish(found_workflow) {
				workflow_name = arg
				found_workflow = true
			} else {
				workflow_args = push(workflow_args, arg)
			}
		} else if arg == "--" {
			literal_args = true
		} else if is_falseish(found_workflow) {
			if is_run_value_flag(arg) {
				step = 2
			} else if is_falseish(is_run_bool_flag(arg)) {
				workflow_name = arg
				found_workflow = true
			}
		} else if is_run_value_flag(arg) {
			step = 2
		} else if is_falseish(is_run_bool_flag(arg)) {
			workflow_args = push(workflow_args, arg)
		}

		idx = idx + step
	}

	return {"workflow": workflow_name, "args": workflow_args}
}

# =============================================================================
# INIT
# =============================================================================
func cmd_init() {
	if is_trueish(file_exists(".muzzle")) && (is_falseish(path_is_dir(".muzzle")) || is_falseish(path_is_within_muzzle(".muzzle"))) {
		print("Error: .muzzle is not a safe project-local directory. Refusing to initialize.")
		exit(1)
	}
	managed_paths := array(WORKFLOWS_DIR, MANIFESTS_DIR, ".muzzle/logs", ".muzzle/reports", ".muzzle/state", ".muzzle/state/loops")
	mut managed_idx := 0
	while managed_idx < len(managed_paths) {
		managed_path := managed_paths[managed_idx]
		if is_falseish(existing_muzzle_path_is_safe(managed_path)) {
			print("Error: " + managed_path + " resolves outside .muzzle. Refusing to initialize.")
			exit(1)
		}
		managed_idx = managed_idx + 1
	}
	if has_muzzle_dir() && is_trueish(file_exists(WORKFLOWS_DIR)) && is_trueish(file_exists(MANIFESTS_DIR)) && is_trueish(file_exists(".muzzle/logs")) && is_trueish(file_exists(".muzzle/reports")) && is_trueish(file_exists(".muzzle/state/loops")) {
		print("Muzzle: .muzzle/ already exists. Nothing to do.")
		exit(0)
	}

	ensure_dir(WORKFLOWS_DIR)
	ensure_dir(MANIFESTS_DIR)
	ensure_dir(".muzzle/logs")
	ensure_dir(".muzzle/reports")
	ensure_dir(".muzzle/state/loops")

	# Create example hello workflow (Kujo — default runner)
	hello_script := join(array(
		"// Hello workflow — a safe, read-only example for Muzzle.",
		"// Runs in Kujo (default runner).",
		"print(\"Hello from Muzzle!\")",
		"print(\"Runner: Kujo (default)\")",
		"print(\"This is a sample workflow. Replace with your own.\")"
	), "\n") + "\n"
	if is_falseish(file_exists(WORKFLOWS_DIR + "/hello.kujo")) {
		write_file(WORKFLOWS_DIR + "/hello.kujo", hello_script)
	}

	# Create example Bash workflow as well
	bash_script := join(array(
		"#!/usr/bin/env bash",
		"# Hello workflow (Bash runner) — a safe, read-only example.",
		"echo \"Hello from Muzzle (Bash)!\"",
		"echo \"Current directory: $(pwd)\"",
		"echo \"Date: $(date -u +\"%Y-%m-%dT%H:%M:%SZ\")\"",
		"exit 0"
	), "\n") + "\n"
	if is_falseish(file_exists(WORKFLOWS_DIR + "/hello-bash.sh")) {
		write_file(WORKFLOWS_DIR + "/hello-bash.sh", bash_script)
	}

	# Create manifests
	hello_manifest := join(array(
		"{",
		"  \"name\": \"hello\",",
		"  \"summary\": \"Simple hello-world workflow (Kujo runner). Safe and read-only.\",",
		"  \"runner\": \"kujo\",",
		"  \"script\": \"workflows/hello.kujo\",",
		"  \"args\": [],",
		"  \"quiet_by_default\": true,",
		"  \"safety\": {",
		"    \"require_git_repo\": false,",
		"    \"allow_dirty_tree\": true,",
		"    \"requires_network\": false,",
		"    \"human_approval_recommended\": false",
		"  }",
		"}"
	), "\n") + "\n"
	if is_falseish(file_exists(MANIFESTS_DIR + "/hello.json")) {
		write_file(MANIFESTS_DIR + "/hello.json", hello_manifest)
	}

	bash_manifest := join(array(
		"{",
		"  \"name\": \"hello-bash\",",
		"  \"summary\": \"Simple hello-world workflow (Bash runner). Safe and read-only.\",",
		"  \"runner\": \"bash\",",
		"  \"script\": \"workflows/hello-bash.sh\",",
		"  \"args\": [],",
		"  \"quiet_by_default\": true,",
		"  \"safety\": {",
		"    \"require_git_repo\": false,",
		"    \"allow_dirty_tree\": true,",
		"    \"requires_network\": false,",
		"    \"human_approval_recommended\": false",
		"  }",
		"}"
	), "\n") + "\n"
	if is_falseish(file_exists(MANIFESTS_DIR + "/hello-bash.json")) {
		write_file(MANIFESTS_DIR + "/hello-bash.json", bash_manifest)
	}

	# Create session state
	session_json := join(array(
		"{",
		"  \"project\": \"\",",
		"  \"last_workflow\": null,",
		"  \"last_run_at\": null,",
		"  \"total_runs\": 0",
		"}"
	), "\n") + "\n"
	if is_falseish(file_exists(SESSION_FILE)) {
		write_file(SESSION_FILE, session_json, true)
	}

	# Create .gitignore
	gitignore := join(array(
		"# Muzzle logs and reports — local workflow artifacts",
		"logs/",
		"reports/",
		"state/session.json",
		"state/session.lock"
	), "\n") + "\n"
	if is_falseish(file_exists(".muzzle/.gitignore")) {
		write_file(".muzzle/.gitignore", gitignore)
	}

	print_lines(array(
		"OK Muzzle initialized in .muzzle/",
		"",
		"  Created:",
		"    .muzzle/workflows/hello.kujo      (Kujo example — default)",
		"    .muzzle/workflows/hello-bash.sh   (Bash example)",
		"    .muzzle/manifests/hello.json",
		"    .muzzle/manifests/hello-bash.json",
		"    .muzzle/logs/",
		"    .muzzle/reports/",
		"    .muzzle/state/",
		"",
		"  Next steps:",
		"    muzzle list              — see available workflows",
		"    muzzle run hello         — run the Kujo example (default)",
		"    muzzle run hello-bash    — run the Bash example",
		"    muzzle info hello        — see workflow details"
	))
}

# =============================================================================
# LIST
# =============================================================================
func cmd_list() {
	if is_falseish(has_muzzle_dir()) {
		print("Error: No .muzzle/ directory found. Run 'muzzle init' first.")
		exit(1)
	}

	workflows := discover_workflows()

	if len(workflows) == 0 {
		print_lines(array(
			"No workflows found in .muzzle/",
			"Add scripts to .muzzle/workflows/ or manifests to .muzzle/manifests/"
		))
		exit(0)
	}

	print_lines(array(
		"WORKFLOW             RUNNER   SUMMARY",
		"--------             ------   -------"
	))

	mut workflow_idx := 0
	while workflow_idx < len(workflows) {
		wf := workflows[workflow_idx]
		name := to_string(wf["name"])
		runner := to_string(wf["runner"])
		summary := ""
		if dict_has_key(wf, "summary") {
			summary = to_string(wf["summary"])
		}
		if summary == "" {
			summary = "-"
		}

		# Pad name to 20 chars
		name_padded := name
		while len(name_padded) < 20 {
			name_padded = name_padded + " "
		}

		print(name_padded + " " + runner + "      " + summary)
		workflow_idx = workflow_idx + 1
	}
}

# =============================================================================
# INFO
# =============================================================================
func cmd_info(name) {
	if is_falseish(has_muzzle_dir()) {
		print("Error: No .muzzle/ directory found. Run 'muzzle init' first.")
		exit(1)
	}

	info := get_workflow_info(name)
	if info == null {
		print("Error: Workflow '" + name + "' not found. Check available workflows with 'muzzle list'.")
		exit(1)
	}
	if dict_has_key(info, "args") {
		manifest_args := info["args"]
		if type(manifest_args) != "array" {
			print("Error: Invalid manifest for '" + name + "': args must be an array.")
			exit(2)
		}
		mut manifest_arg_idx := 0
		while manifest_arg_idx < len(manifest_args) {
			manifest_arg := manifest_args[manifest_arg_idx]
			if type(manifest_arg) != "dict" || is_falseish(dict_has_key(manifest_arg, "name")) {
				print("Error: Invalid manifest for '" + name + "': every argument must be an object with a name.")
				exit(2)
			}
			manifest_arg_idx = manifest_arg_idx + 1
		}
	}

	print_kv("Workflow:   ", info["name"])
	if dict_has_key(info, "summary") {
		print_kv("Summary:    ", info["summary"])
	} else {
		print("Summary:    (no manifest)")
	}
	print_kv("Runner:     ", info["runner"])
	print_kv("Script:     ", info["script_path"])

	if dict_has_key(info, "args") {
		args_arr := info["args"]
		if len(args_arr) > 0 {
			print("Arguments:")
			mut ai := 0
			while ai < len(args_arr) {
				arg := args_arr[ai]
				req := "(optional)"
				if dict_has_key(arg, "required") && is_trueish(arg["required"]) {
					req = "(required)"
				}
				desc := ""
				if dict_has_key(arg, "description") {
					desc = to_string(arg["description"])
				}
				print("  " + to_string(arg["name"]) + " " + req + ": " + desc)
				ai = ai + 1
			}
		} else {
			print("Arguments:  (none)")
		}
	} else {
		print("Arguments:  (unknown — no manifest)")
	}

	if dict_has_key(info, "safety") {
		safety := info["safety"]
		print("Safety:")
		mut require_git := "false"
		mut allow_dirty := "true"
		mut requires_net := "false"
		mut human_approval := "false"
		if dict_has_key(safety, "require_git_repo") {
			require_git = to_string(safety["require_git_repo"])
		}
		if dict_has_key(safety, "allow_dirty_tree") {
			allow_dirty = to_string(safety["allow_dirty_tree"])
		}
		if dict_has_key(safety, "requires_network") {
			requires_net = to_string(safety["requires_network"])
		}
		if dict_has_key(safety, "human_approval_recommended") {
			human_approval = to_string(safety["human_approval_recommended"])
		}
		print_lines(array(
			"  require_git_repo:           " + require_git,
			"  allow_dirty_tree:           " + allow_dirty,
			"  requires_network:           " + requires_net,
			"  human_approval_recommended:  " + human_approval
		))
	} else {
		print("Safety:     (unknown — no manifest)")
	}
}

# =============================================================================
# RUN
# =============================================================================
func cmd_run(argv) {
	if is_falseish(has_muzzle_dir()) {
		print("Error: No .muzzle/ directory found. Run 'muzzle init' first.")
		exit(1)
	}

	# Parse flags
	verbose := has_run_option(argv, "--verbose") || has_run_option(argv, "-v")
	dry_run := has_run_option(argv, "--dry-run") || has_run_option(argv, "-n")
	json_out := has_run_option(argv, "--json")
	if is_trueish(option_missing_value(argv, "--runner")) {
		print("Error: --runner requires a value: kujo, bash, python, or node.")
		exit(2)
	}
	if is_trueish(option_missing_value(argv, "--timeout")) {
		print("Error: --timeout requires an integer value in milliseconds.")
		exit(2)
	}
	runner_override := run_option_value(argv, "--runner", "")
	timeout_str := run_option_value(argv, "--timeout", "300000")
	if runner_override != "" && is_falseish(valid_runner(runner_override)) {
		print("Error: Unsupported runner '" + runner_override + "'. Use: kujo, bash, python, or node.")
		exit(2)
	}
	timeout_ms := 300000
	mut timeout_parsed := null
	try {
		timeout_parsed = parse_int(timeout_str)
	} except _err {
		print("Error: Invalid timeout '" + timeout_str + "'. Use an integer number of milliseconds.")
		exit(2)
	}
	timeout_ms = to_int(timeout_parsed)
	if timeout_ms < 1000 {
		timeout_ms = 1000
	}
	if timeout_ms > 3600000 {
		timeout_ms = 3600000
	}

	# Get workflow name and args while allowing literal workflow args after --.
	run_args := parse_run_invocation(argv)
	workflow_name := to_string(run_args["workflow"])
	if workflow_name == "" {
		print("Error: Usage: muzzle run <workflow> [args...]")
		exit(2)
	}

	# Validate workflow name for safety
	if is_falseish(validate_workflow_name(workflow_name)) {
		print_lines(array(
			"Error: Invalid workflow name '" + workflow_name + "'.",
			"Workflow names must not contain /, \\, or .. and must be 1-128 characters."
		))
		exit(1)
	}

	workflow_args := run_args["args"]

	# Resolve script
	script_path := resolve_workflow_script(workflow_name)
	if script_path == "" {
		print("Error: Workflow '" + workflow_name + "' not found. Check available workflows with 'muzzle list'.")
		exit(1)
	}

	if is_falseish(validate_script_path(script_path)) {
		print("Error: Workflow script '" + script_path + "' is outside expected directory. Refusing to run.")
		exit(1)
	}
	if is_falseish(existing_muzzle_path_is_safe(".muzzle/logs")) || is_falseish(existing_muzzle_path_is_safe(".muzzle/reports")) {
		print("Error: Muzzle artifact directories resolve outside .muzzle. Refusing to run.")
		exit(1)
	}

	# Load manifest for metadata
	manifest := load_manifest(workflow_name)
	if runner_override == "" && manifest != null && dict_has_key(manifest, "runner") && is_falseish(valid_runner(manifest["runner"])) {
		manifest_runner := to_string(manifest["runner"])
		print("Error: Unsupported runner '" + manifest_runner + "' in manifest. Use: kujo, bash, python, or node.")
		exit(2)
	}

	# Resolve runner
	runner := resolve_runner(manifest, script_path, runner_override)

	# Dry run
	if dry_run {
		print_lines(array(
			"Muzzle: " + workflow_name + "  [DRY RUN]",
			"Runner:    " + runner_label(runner),
			"Script:    " + script_path,
			"Would execute with runner: " + runner
		))
		if len(workflow_args) > 0 {
			print_kv("Args:      ", join(workflow_args, " "))
		}
		exit(0)
	}

	# Prepare paths
	ts := timestamp_compact()
	paths := make_paths(workflow_name, ts)
	log_path := to_string(paths["log"])
	report_path := to_string(paths["report"])
	ensure_dir(".muzzle/logs")
	ensure_dir(".muzzle/reports")

	# Build and execute command
	started_at := timestamp_iso()
	start_ms := current_timestamp()

	cmd := build_command(runner, script_path, workflow_args)

	# Execute and capture output
	mut exit_code := 0
	mut raw_output := ""

	try {
		raw_output = execute(cmd, {"timeout_ms": timeout_ms})
	} except err {
		# Execution failed — capture the error
		raw_output = to_string(err)
		exit_code = 1
	}

	# Parse captured output for exit code
	parsed := parse_captured_output(raw_output)
	if type(parsed) == "Error" {
		# Could not parse — use raw output
	} else {
		if dict_has_key(parsed, "marker_found") && is_trueish(parsed["marker_found"]) && dict_has_key(parsed, "exit_code") {
			exit_code = parsed["exit_code"]
		}
		if dict_has_key(parsed, "output") {
			raw_output = to_string(parsed["output"])
		}
	}

	end_ms := current_timestamp()
	finished_at := timestamp_iso()
	duration_ms := end_ms - start_ms
	if duration_ms < 0 {
		duration_ms = 0
	}

	# Determine status
	status := "success"
	summary_line := "The workflow completed successfully."
	mut err_text := ""
	if exit_code != 0 {
		status = "failed"
		summary_line = "The workflow failed with exit code " + to_string(exit_code) + "."
		err_text = error_excerpt(raw_output, 5)
	}

	# Write log file (full output, not redacted)
	write_file(log_path, raw_output)

	# Write reports (with redaction)
	write_markdown_report(workflow_name, status, exit_code, started_at, finished_at, duration_ms, log_path, report_path, summary_line, err_text)
	write_json_report(workflow_name, status, exit_code, started_at, finished_at, duration_ms, log_path, report_path, summary_line, err_text)

	# Update session state.
	update_session_state(workflow_name, finished_at)

	# Output
	if json_out {
		# Print JSON report to stdout
		json_report_path := replace(report_path, ".md", ".json")
		if is_trueish(file_exists(json_report_path)) {
			print(read_file(json_report_path))
		}
	} else if verbose {
		# Verbose: print full output
		print_lines(array(
			"Muzzle: " + workflow_name + "  [verbose]",
			"Runner: " + runner_label(runner),
			"---",
			raw_output,
			"---",
			"",
			"Status:     " + status,
			"Exit code:  " + to_string(exit_code),
			"Duration:   " + format_duration_ms(duration_ms),
			"Report:     " + report_path,
			"Log:        " + log_path
		))
	} else {
		# Quiet default output
		if runner != "kujo" {
			print_lines(array(
				"",
				"Muzzle: " + workflow_name,
				"Runner:    " + runner_label(runner),
				""
			))
		} else {
			print_lines(array(
				"",
				"Muzzle: " + workflow_name,
				""
			))
		}
		if status == "success" {
			print("Status:     success")
		} else {
			print("Status:     failed")
		}
		print_lines(array(
			"Exit code:  " + to_string(exit_code),
			"Duration:   " + format_duration_ms(duration_ms),
			""
		))

		if status == "failed" && err_text != "" {
			print_lines(array(
				"Error excerpt:",
				err_text,
				""
			))
		}

		print_lines(array(
			"Report:     " + report_path,
			"Log:        " + log_path,
			""
		))
		if is_falseish(verbose) && status == "success" {
			print_lines(array(
				"Use --verbose for full output or --json for machine-readable format.",
				""
			))
		}
	}

	exit(exit_code)
}

func artifact_matches_workflow(entry_name, workflow_name, extension) {
	prefix := workflow_name + "-"
	if is_falseish(str_starts_with(entry_name, prefix)) || is_falseish(str_ends_with(entry_name, extension)) {
		return false
	}
	stem_end := len(entry_name) - len(extension)
	stem := substring(entry_name, len(prefix), stem_end)
	parts := split(stem, "-")
	if len(parts) != 2 || len(parts[1]) != 32 {
		return false
	}
	timestamp_value := parse_int(parts[0])
	return type(timestamp_value) != "Error"
}

# =============================================================================
# LOGS
# =============================================================================
func cmd_logs(filter) {
	if is_falseish(has_muzzle_dir()) {
		print("Error: No .muzzle/ directory found. Run 'muzzle init' first.")
		exit(1)
	}

	if is_falseish(file_exists(".muzzle/logs")) {
		print("No logs directory found.")
		exit(0)
	}
	if is_falseish(path_is_dir(".muzzle/logs")) || is_falseish(path_is_within_muzzle(".muzzle/logs")) {
		print("Error: Muzzle log directory resolves outside .muzzle. Refusing to inspect it.")
		exit(1)
	}

	if filter != "" {
		# Show logs for specific workflow
		entries := list_dir(".muzzle/logs")
		mut log_found := 0
		mut log_filter_idx := 0
		while log_filter_idx < len(entries) {
			entry_name := to_string(entries[log_filter_idx])
			if is_trueish(artifact_matches_workflow(entry_name, filter, ".log")) {
				print("Log: .muzzle/logs/" + entry_name)
				log_found = log_found + 1
			}
			log_filter_idx = log_filter_idx + 1
		}
		if log_found == 0 {
			print("No logs found for workflow '" + filter + "'.")
		}
	} else {
		print_lines(array(
			"Recent logs:",
			""
		))
		entries := list_dir(".muzzle/logs")
		mut log_count := 0
		mut log_list_idx := 0
		while log_list_idx < len(entries) {
			entry_name := to_string(entries[log_list_idx])
			if is_trueish(str_ends_with(entry_name, ".log")) {
				log_full := ".muzzle/logs/" + entry_name
				if is_trueish(path_is_within_muzzle(log_full)) {
					fsize := file_size(log_full)
					print("  " + entry_name + "    " + to_string(fsize) + " bytes")
					log_count = log_count + 1
				}
			}
			log_list_idx = log_list_idx + 1
		}
		if log_count == 0 {
			print("  (no logs yet)")
		} else {
			print_lines(array(
				"",
				"Use 'muzzle logs <workflow>' to filter by workflow name."
			))
		}
	}
}

# =============================================================================
# REPORT
# =============================================================================
func cmd_report(filter) {
	if is_falseish(has_muzzle_dir()) {
		print("Error: No .muzzle/ directory found. Run 'muzzle init' first.")
		exit(1)
	}

	if is_falseish(file_exists(".muzzle/reports")) {
		print("No reports directory found.")
		exit(0)
	}
	if is_falseish(path_is_dir(".muzzle/reports")) || is_falseish(path_is_within_muzzle(".muzzle/reports")) {
		print("Error: Muzzle report directory resolves outside .muzzle. Refusing to inspect it.")
		exit(1)
	}

	if filter != "" {
		entries := list_dir(".muzzle/reports")
		mut report_found := 0
		mut report_filter_idx := 0
		while report_filter_idx < len(entries) {
			entry_name := to_string(entries[report_filter_idx])
			if is_trueish(artifact_matches_workflow(entry_name, filter, ".md")) {
				print("Report: .muzzle/reports/" + entry_name)
				report_found = report_found + 1
			}
			report_filter_idx = report_filter_idx + 1
		}
		if report_found == 0 {
			print("No reports found for workflow '" + filter + "'.")
		}
	} else {
		print_lines(array(
			"Recent reports:",
			""
		))
		entries := list_dir(".muzzle/reports")
		mut report_count := 0
		mut report_list_idx := 0
		while report_list_idx < len(entries) {
			entry_name := to_string(entries[report_list_idx])
			if is_trueish(str_ends_with(entry_name, ".md")) {
				print("  " + entry_name)
				report_count = report_count + 1
			}
			report_list_idx = report_list_idx + 1
		}
		if report_count == 0 {
			print("  (no reports yet)")
		} else {
			print_lines(array(
				"",
				"Use 'muzzle report <workflow>' to filter by workflow name.",
				"Use 'cat .muzzle/reports/<file>' to read a full report."
			))
		}
	}
}

# =============================================================================
# CLEAN
# =============================================================================
func cmd_clean(argv) {
	if is_falseish(has_muzzle_dir()) {
		print("Error: No .muzzle/ directory found. Run 'muzzle init' first.")
		exit(1)
	}

	if is_falseish(existing_muzzle_path_is_safe(".muzzle/logs")) || is_falseish(existing_muzzle_path_is_safe(".muzzle/reports")) {
		print("Error: Muzzle artifact directories resolve outside .muzzle. Refusing to clean.")
		exit(1)
	}

	mut removed_logs := 0
	mut removed_reports := 0
	mut removal_failures := 0

	# Clean logs
	if is_trueish(file_exists(".muzzle/logs")) {
		entries := list_dir(".muzzle/logs")
		mut clean_log_idx := 0
		while clean_log_idx < len(entries) {
			entry_name := to_string(entries[clean_log_idx])
			log_path := ".muzzle/logs/" + entry_name
			if is_trueish(file_exists(log_path)) {
				try {
					delete_file(log_path)
					removed_logs = removed_logs + 1
				} except _err {
					removal_failures = removal_failures + 1
				}
			}
			clean_log_idx = clean_log_idx + 1
		}
	}

	# Clean reports
	if is_trueish(file_exists(".muzzle/reports")) {
		entries := list_dir(".muzzle/reports")
		mut clean_report_idx := 0
		while clean_report_idx < len(entries) {
			entry_name := to_string(entries[clean_report_idx])
			report_path := ".muzzle/reports/" + entry_name
			if is_trueish(file_exists(report_path)) {
				try {
					delete_file(report_path)
					removed_reports = removed_reports + 1
				} except _err {
					removal_failures = removal_failures + 1
				}
			}
			clean_report_idx = clean_report_idx + 1
		}
	}

	print_lines(array(
		"Muzzle: Cleaned up workflow artifacts.",
		"  Removed: " + to_string(removed_logs) + " logs, " + to_string(removed_reports) + " reports"
	))
	if removal_failures > 0 {
		print("Error: Failed to remove " + to_string(removal_failures) + " artifact entries.")
		exit(1)
	}
}

# =============================================================================
# LOOP
# =============================================================================
func cmd_loop(argv) {
	if is_falseish(has_muzzle_dir()) {
		print("Error: No .muzzle/ directory found. Run 'muzzle init' first.")
		exit(1)
	}

	if is_falseish(existing_muzzle_path_is_safe(".muzzle/state")) || is_falseish(existing_muzzle_path_is_safe(".muzzle/state/loops")) {
		print("Error: Muzzle loop state resolves outside .muzzle. Refusing to continue.")
		exit(1)
	}
	ensure_dir(".muzzle/state/loops")
	invalid_loop_state := find_invalid_loop_state()
	if invalid_loop_state != "" {
		print("Error: Invalid loop state in '" + invalid_loop_state + "'. Refusing to continue.")
		exit(1)
	}

	pos_args := positional_args(argv)
	if len(pos_args) < 1 {
		print("Error: Usage: muzzle loop <start|next|done|status|summary> [options]")
		exit(2)
	}

	subcmd := to_string(pos_args[0])

	if subcmd == "start" {
		# muzzle loop start <workflow> --limit <n>
		mut wf_name := ""
		mut limit := 10
		# Parse from raw argv for flags
		if is_trueish(option_missing_value(argv, "--limit")) {
			print("Error: --limit requires an integer value.")
			exit(2)
		}
		limit_str := to_string(flag_value(argv, "--limit", "10"))
		mut limit_parsed := null
		try {
			limit_parsed = parse_int(limit_str)
		} except _err {
			print("Error: Invalid loop limit '" + limit_str + "'. Use an integer.")
			exit(2)
		}
		limit = to_int(limit_parsed)
		# Workflow name is the first positional after 'start'
		if len(pos_args) > 1 {
			wf_name = to_string(pos_args[1])
		}
		if wf_name == "" {
			print("Error: Usage: muzzle loop start <workflow> --limit <n>")
			exit(2)
		}
		if is_falseish(validate_workflow_name(wf_name)) {
			print_lines(array(
				"Error: Invalid workflow name '" + wf_name + "'.",
				"Workflow names must not contain /, \\, or .. and must be 1-128 characters."
			))
			exit(1)
		}
		if limit < 1 {
			limit = 1
		}
		if limit > 1000 {
			limit = 1000
		}
		# Validate workflow exists
		script_path := resolve_workflow_script(wf_name)
		if script_path == "" {
			print("Error: Workflow '" + wf_name + "' not found.")
			exit(1)
		}
		# Check if loop already exists
		existing := find_active_loop()
		if existing != "" {
			existing_data := load_loop(existing)
			if existing_data != null && to_string(existing_data["workflow"]) == wf_name {
				print("Muzzle: Loop '" + wf_name + "' already exists. Use 'muzzle loop status' to check progress.")
				exit(0)
			}
			print("Error: Another active loop already exists. Complete it before starting '" + wf_name + "'.")
			exit(1)
		}
		ts := timestamp_iso()
		loop_state_path := ".muzzle/state/loops/" + wf_name + ".json"
		if is_trueish(file_exists(loop_state_path)) && is_falseish(path_is_within_muzzle(loop_state_path)) {
			print("Error: Loop state for '" + wf_name + "' resolves outside .muzzle. Refusing to overwrite it.")
			exit(1)
		}
		create_loop(wf_name, limit, ts)
		print_lines(array(
			"Muzzle: Loop started: " + wf_name + " (0/" + to_string(limit) + ")",
			"",
			"  Run 'muzzle loop next' to begin the first iteration.",
			"  After each iteration, record with 'muzzle loop done --note \"...\"'"
		))

	} else if subcmd == "next" {
		loop_file := find_active_loop()
		if loop_file == "" {
			print("Error: No active loop found. Start one with 'muzzle loop start <workflow> --limit <n>'.")
			exit(1)
		}
		existing_data := load_loop(loop_file)
		if existing_data != null && is_falseish(current_iteration_recorded(existing_data)) {
			print("Error: Complete the current iteration with 'muzzle loop done' before advancing.")
			exit(1)
		}
		loop_data := advance_loop(loop_file)
		if loop_data == null {
			# Loop completed
			existing := load_loop(loop_file)
			if existing != null {
				current := to_int(existing["current"])
				limit := to_int(existing["limit"])
				print("Loop '" + to_string(existing["workflow"]) + "' is complete (" + to_string(current) + "/" + to_string(limit) + ").")
				print("Run 'muzzle loop summary' to see all entries.")
			}
			exit(0)
		}
		current := to_int(loop_data["current"])
		limit := to_int(loop_data["limit"])
		print_lines(array(
			"",
			"Loop " + to_string(current) + "/" + to_string(limit) + ": " + to_string(loop_data["workflow"]),
			"",
			"  Run your workflow iteration, then record it with:",
			"  muzzle loop done --note \"what you accomplished\"",
			""
		))

	} else if subcmd == "done" {
		note := flag_value(argv, "--note", "")
		loop_file := find_active_loop()
		if loop_file == "" {
			print("Error: No active loop found.")
			exit(1)
		}
		ts := timestamp_iso()
		ok := record_loop_done(loop_file, note, ts)
		if is_falseish(ok) {
			print("Error: Failed to record loop entry.")
			exit(1)
		}
		loop_data := load_loop(loop_file)
		current := 0
		if loop_data != null {
			current = to_int(loop_data["current"])
		}
		print("OK Loop " + to_string(current) + ": " + to_string(loop_data["workflow"]) + " — recorded.")
		if note != "" {
			print("  Note: " + note)
		}
		print_lines(array(
			"",
			"  Run 'muzzle loop next' for the next iteration."
		))

	} else if subcmd == "status" {
		loop_file := find_active_loop()
		if loop_file == "" {
			# Show all loops
			all_loops := list_all_loops()
			if len(all_loops) == 0 {
				print("No loops found. Start one with 'muzzle loop start <workflow> --limit <n>'.")
			} else {
				mut status_loop_idx := 0
				while status_loop_idx < len(all_loops) {
					lp := all_loops[status_loop_idx]
					print(to_string(lp["workflow"]) + "    " + to_string(lp["status"]))
					status_loop_idx = status_loop_idx + 1
				}
			}
			exit(0)
		}
		loop_data := load_loop(loop_file)
		if loop_data == null {
			exit(0)
		}
		print_kv("Loop:       ", loop_data["workflow"])
		print("Progress:   " + to_string(loop_data["current"]) + "/" + to_string(loop_data["limit"]))
		print_kv("Status:     ", loop_data["status"])
		print_kv("Started:    ", loop_data["started_at"])
		entries := loop_data["entries"]
		print("Completed:  " + to_string(len(entries)) + " iterations")
		if len(entries) > 0 {
			print("")
			mut status_entry_idx := 0
			while status_entry_idx < len(entries) {
				entry := entries[status_entry_idx]
				note_str := ""
				if dict_has_key(entry, "note") {
					note_str = to_string(entry["note"])
				}
				print("  [" + to_string(entry["loop"]) + "] " + to_string(entry["status"]) + " — " + note_str)
				status_entry_idx = status_entry_idx + 1
			}
		}

	} else if subcmd == "summary" {
		all_loops := list_all_loops()
		if len(all_loops) == 0 {
			print("No loops found.")
			exit(0)
		}
		mut summary_loop_idx := 0
		while summary_loop_idx < len(all_loops) {
			lp := all_loops[summary_loop_idx]
			print_lines(array(
				"# Loop: " + to_string(lp["workflow"]),
				"Status: " + to_string(lp["status"]) + "  |  Progress: " + to_string(lp["current"]) + "/" + to_string(lp["limit"]),
				"Started: " + to_string(lp["started_at"]),
				""
			))
			entries := lp["entries"]
			if len(entries) > 0 {
				print_lines(array(
					"| # | Status | Note | Timestamp |",
					"|---|--------|------|-----------|"
				))
				mut summary_entry_idx := 0
				while summary_entry_idx < len(entries) {
					entry := entries[summary_entry_idx]
					note_str := ""
					if dict_has_key(entry, "note") {
						note_str = to_string(entry["note"])
						note_str = replace(note_str, "\r", " ")
						note_str = replace(note_str, "\n", " ")
						note_str = replace(note_str, "\\", "\\\\")
						note_str = replace(note_str, "|", "\\|")
						if len(note_str) > 60 {
							note_str = substring(note_str, 0, 57) + "..."
						}
					}
					ts_str := ""
					if dict_has_key(entry, "timestamp") {
						ts_str = to_string(entry["timestamp"])
					}
					print("| " + to_string(entry["loop"]) + " | " + to_string(entry["status"]) + " | " + note_str + " | " + ts_str + " |")
					summary_entry_idx = summary_entry_idx + 1
				}
			} else {
				print("No entries recorded.")
			}
			print("")
			summary_loop_idx = summary_loop_idx + 1
		}

	} else {
		print("Error: Unknown loop command: '" + subcmd + "'. Use: start, next, done, status, summary")
		exit(2)
	}
}

# =============================================================================
# MAIN
# =============================================================================
func main() {
	argv := args()

	if len(argv) < 1 {
		print_help()
		exit(0)
	}

	first_arg := to_string(argv[0])
	if first_arg == "--help" || first_arg == "-h" {
		print_help()
		exit(0)
	}

	if first_arg == "--version" || first_arg == "-V" {
		print_version()
		exit(0)
	}

	subcommand := parse_subcommand(argv)
	if subcommand == "" || subcommand == "help" {
		print_help()
		exit(0)
	}

	if subcommand == "version" {
		print_version()
		exit(0)
	}

	if subcommand == "init" {
		cmd_init()
		exit(0)
	}

	if subcommand == "list" || subcommand == "ls" {
		cmd_list()
		exit(0)
	}

	if subcommand == "info" || subcommand == "show" {
		pos_args := positional_args(argv)
		if len(pos_args) < 1 {
			print("Error: Usage: muzzle info <workflow>")
			exit(2)
		}
		cmd_info(to_string(pos_args[0]))
		exit(0)
	}

	if subcommand == "run" || subcommand == "execute" {
		cmd_run(argv)
		exit(0)
	}

	if subcommand == "logs" || subcommand == "log" {
		filter := ""
		pos_args := positional_args(argv)
		if len(pos_args) > 0 {
			filter = to_string(pos_args[0])
		}
		cmd_logs(filter)
		exit(0)
	}

	if subcommand == "report" || subcommand == "reports" {
		filter := ""
		pos_args := positional_args(argv)
		if len(pos_args) > 0 {
			filter = to_string(pos_args[0])
		}
		cmd_report(filter)
		exit(0)
	}

	if subcommand == "loop" {
		cmd_loop(argv)
		exit(0)
	}

	if subcommand == "clean" {
		cmd_clean(argv)
		exit(0)
	}

	# Unknown command
	print("Error: Unknown command: '" + subcommand + "'. Run 'muzzle help' for usage.")
	exit(2)
}

main()
